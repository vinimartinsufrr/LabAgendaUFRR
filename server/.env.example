# Porta em que a API vai rodar
PORT=3333

# String de conexão do MongoDB (local ou Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/labagenda

# Segredo usado para assinar os tokens JWT (troque por um valor longo e aleatório)
JWT_SECRET=troque-este-segredo
# Validade do token (formato aceito pelo jsonwebtoken: 1h, 8h, 7d...)
JWT_EXPIRES_IN=8h

# Endereço(s) do frontend liberados no CORS e no Socket.io (separe por vírgula)
CLIENT_URL=http://localhost:5173

# Usuário administrador criado pelo "npm run seed"
ADMIN_EMAIL=admin@ufrr.br
ADMIN_SENHA=admin123
